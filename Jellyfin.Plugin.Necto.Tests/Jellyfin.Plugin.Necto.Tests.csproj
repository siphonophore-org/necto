<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Necto.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      Tests are less strict than the production project. The analyzer flags patterns tests use on purpose,
      such as underscores in test names (CA1707) and awaits without ConfigureAwait (CA2007), so analysis runs
      at its default level and warnings stay warnings.
    -->
    <AnalysisMode>Default</AnalysisMode>
    <NoWarn>CA1707;CA2007;CA1305;CA1062;CA1822;CA1861;xUnit1004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Native SQLite builds before 2.1.12 carry a high severity advisory (GHSA-2m69-gcr7-jv3q).
         Microsoft.Data.Sqlite 10.0.11 already pulls 2.1.12, and the pin keeps it from ever resolving lower.
         The plugin itself uses the SQLite that ships with Jellyfin. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />

    <!-- The plugin's Jellyfin packages without PrivateAssets, so their types are visible to the tests. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The proxy tests start its Kestrel host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.Necto\Jellyfin.Plugin.Necto.csproj" />
  </ItemGroup>

</Project>
