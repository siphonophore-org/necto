<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Necto</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <NoWarn>NU1605;CA1002;CA2227;CA1305;CA2213;CA3003</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.4.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.4.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Siphonophore.Stolon" Version="12.4.8" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every file served to the browser -->
    <None Remove="Web\**\*" />
    <EmbeddedResource Include="Web\**\*" />
  </ItemGroup>

  <!-- Jellyfin strings the pages use. Stolon builds them in with Localization/*.json, in every language Jellyfin has. -->
  <ItemGroup>
    <JellyfinString Include="Delete" />
    <JellyfinString Include="DeleteName" />
    <JellyfinString Include="LabelName" />
    <JellyfinString Include="Save" />
    <JellyfinString Include="Settings" />
    <JellyfinString Include="TabDashboard" />
    <JellyfinString Include="All" />
    <JellyfinString Include="HeaderLibraries" />
    <JellyfinString Include="LabelAvailable" />
    <JellyfinString Include="Folders" />
    <JellyfinString Include="LabelDevice" />
    <JellyfinString Include="LabelFolder" />
    <JellyfinString Include="LabelStatus" />
    <JellyfinString Include="LabelSystem" />
    <JellyfinString Include="LabelType" />
    <JellyfinString Include="Refresh" />
    <JellyfinString Include="LabelSize" />
    <JellyfinString Include="Alerts" />
    <JellyfinString Include="Off" />
    <JellyfinString Include="None" />
    <JellyfinString Include="External" />
    <JellyfinString Include="StorageType.Network" />
    <JellyfinString Include="Name" />
    <JellyfinString Include="LabelWeb" />
    <JellyfinString Include="LabelLogs" />
    <JellyfinString Include="LabelMetadata" />
    <JellyfinString Include="LabelCache" />
    <JellyfinString Include="LabelTranscodes" />
    <!-- The plugin's own key keeps English Jellyfin also says, with another meaning. -->
    <JellyfinTextMatch Include="TitleNewGroup" />
    <JellyfinTextMatch Include="StorageHeaderFormat" />
    <JellyfinTextMatch Include="StorageLabelSpace" />
  </ItemGroup>

</Project>
