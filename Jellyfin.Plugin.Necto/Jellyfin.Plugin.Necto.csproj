<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Necto</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <NoWarn>NU1605;CA1002;CA2227;CA1305;CA2213;CA3003</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.4.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.4.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Siphonophore.Stolon" Version="12.4.8" />
    <!-- Proxy: the reverse proxy, Let's Encrypt, and the location database. -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="Certes" Version="4.1.0" />
    <PackageReference Include="MaxMind.Db" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The proxy runs its own Kestrel host. ASP.NET Core comes from the shared framework Jellyfin loads. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Necto.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every file served to the browser -->
    <None Remove="Web\**\*" />
    <EmbeddedResource Include="Web\**\*" />
  </ItemGroup>

  <!-- Jellyfin strings the pages use. Stolon builds them in with Localization/*.json, in every language Jellyfin has. -->
  <ItemGroup>
    <JellyfinString Include="Delete" />
    <JellyfinString Include="HeaderApiKey" />
    <JellyfinString Include="LabelPassword" />
    <JellyfinString Include="LabelServerHost" />
    <JellyfinString Include="LabelUser" />
    <JellyfinString Include="LabelUsername" />
    <JellyfinString Include="DeleteName" />
    <JellyfinString Include="LabelName" />
    <JellyfinString Include="Save" />
    <JellyfinString Include="Settings" />
    <JellyfinString Include="TabDashboard" />
    <JellyfinString Include="Unknown" />
    <JellyfinString Include="Auto" />
    <JellyfinString Include="ButtonCancel" />
    <JellyfinString Include="ButtonRemove" />
    <JellyfinString Include="GuideProviderLogin" />
    <JellyfinString Include="HeaderActivity" />
    <JellyfinString Include="LabelCertificatePassword" />
    <JellyfinString Include="LabelDevice" />
    <JellyfinString Include="LabelFailed" />
    <JellyfinString Include="LabelSource" />
    <JellyfinString Include="Next" />
    <JellyfinString Include="No" />
    <JellyfinString Include="None" />
    <JellyfinString Include="Off" />
    <JellyfinString Include="People" />
    <JellyfinString Include="Reset" />
    <JellyfinString Include="Restart" />
    <JellyfinString Include="Upload" />
    <JellyfinString Include="Yes" />
    <!-- The plugin's own key keeps English Jellyfin also says, with another meaning. -->
    <JellyfinTextMatch Include="TitleNewGroup" />
    <!-- A DNS record, not a TV recording. -->
    <JellyfinTextMatch Include="DdnsHeaderRecord" />
  </ItemGroup>

</Project>
